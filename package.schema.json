{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "package.schema.json",
  "title": "Alarkive Package v0.2 manifest",
  "description": "The current manifest.json format for an Alarkive Package v0.2.",
  "type": "object",
  "required": ["schema_version", "id", "name", "created_at", "content"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "0.2",
      "description": "The Alarkive Package schema version."
    },
    "id": {
      "type": "string",
      "pattern": "^[0-9]{8}-[0-9]{6}-[0-9a-f]{4}$",
      "description": "ASCII package ID in YYYYMMDD-HHMMSS-xxxx form."
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "pattern": "[^\\s]",
      "description": "Human-readable package name."
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "description": "RFC 3339/ISO 8601 creation time with a timezone offset or Z."
    },
    "content": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "properties": {
        "public_long": {"$ref": "#/$defs/content_variant"},
        "wechat_long": {"$ref": "#/$defs/content_variant"},
        "wechat_short": {"$ref": "#/$defs/content_variant"},
        "toutiao_short": {"$ref": "#/$defs/content_variant"}
      },
      "description": "One or more saved Content Variants."
    }
  },
  "$defs": {
    "content_variant": {
      "type": "object",
      "required": ["title", "content_file", "images"],
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "pattern": "[^\\s]",
          "description": "Non-empty Content Variant title."
        },
        "content_file": {
          "type": "string",
          "pattern": "^content/(?!\\.{1,2}(?:/|$))[^/\\\\]+(?:/(?!\\.{1,2}(?:/|$))[^/\\\\]+)*$",
          "description": "Package-relative path to the variant's UTF-8 Markdown content."
        },
        "images": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {
            "type": "string",
            "pattern": "^images/(?!\\.{1,2}(?:/|$))[^/\\\\]+(?:/(?!\\.{1,2}(?:/|$))[^/\\\\]+)*\\.[Pp][Nn][Gg]$"
          },
          "description": "Non-empty, ordered list of package-relative PNG paths."
        }
      },
      "description": "Metadata for one Content Variant."
    }
  }
}
